# --- Site identity ---
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com
NEXT_PUBLIC_SITE_NAME=Success Qube

# --- Business details (NAP). Leave blank until real; blank values are hidden, never faked ---
NEXT_PUBLIC_WHATSAPP_NUMBER=            # digits with country code, e.g. 919XXXXXXXXX
NEXT_PUBLIC_BUSINESS_PHONE=             # e.g. +919XXXXXXXXX
NEXT_PUBLIC_BUSINESS_EMAIL=             # public email shown on site
BUSINESS_ADDRESS=                       # street address (server-side only)
BUSINESS_POSTAL_CODE=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=      # Google Maps > Share > Embed a map > copy the src URL
NEXT_PUBLIC_GBP_URL=                    # Google Business Profile link

# --- Social profiles (only filled ones are shown / added to schema sameAs) ---
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_GITHUB=

# --- Analytics / Google ---
NEXT_PUBLIC_GA_ID=                      # GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GSC_VERIFICATION=           # Search Console HTML-tag verification token
NEXT_PUBLIC_GTM_ID=                     # optional

# --- Email delivery for forms (Resend REST API) ---
EMAIL_API_KEY=
EMAIL_FROM=Success Qube <no-reply@your-domain.com>   # sender on a domain verified in Resend
EMAIL_TO=                               # inbox that receives enquiries
